# Copy to a local .env and set your own JWT_SECRET; never commit real secrets.
# Compose forwards JWT_SECRET, ENVIRONMENT, CORS_ORIGINS and ANTHROPIC_*.
# Compose supplies its own database/broker URLs and default shared scan root.
# The connection/root/allowlist values below are native/default settings; see README.
DATABASE_URL=sqlite:///./codesentry.db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
# Set a randomly generated secret (at least 32 characters) for stable sessions.
# Blank uses an ephemeral development key; production rejects blank/weak keys.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
ALLOWED_GITHUB_HOSTS=github.com,www.github.com
SCAN_ROOT=/tmp/codesentry
# Optional. Leave blank for deterministic analyzer-only scans.
# Verify an available model with your own provider account before enabling AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Azure Container Apps: set these on BOTH API and worker using secret references.
# These commented examples are placeholders, not deployment-ready credentials.
# ENVIRONMENT=production
# JWT_SECRET=<same-random-secret-at-least-32-characters-on-api-and-worker>
# DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<server>.postgres.database.azure.com:5432/codesentry?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
# REDIS_URL=rediss://default:<url-encoded-token>@<upstash-endpoint>:6379/0
# CORS_ORIGINS=https://<site>.azurestaticapps.net,https://<future-custom-domain>
# WORKER_QUEUE=celery
# Temporary only; Azure API/worker disks are separate and ephemeral.
# SCAN_ROOT=/tmp/codesentry
# API container listener; match Azure ingress targetPort and probe ports.
PORT=8000
# Frontend BUILD variable (export to Vite; root .env is not read by frontend).
# VITE_API_BASE_URL=https://<api>.azurecontainerapps.io
# See docs/azure-deployment.md for TLS, replicas, startup ordering and limits.
