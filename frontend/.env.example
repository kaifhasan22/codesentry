# Vite reads frontend/.env.local or build-process environment variables.
# Public browser configuration only; never put JWT/database/provider secrets here.
VITE_API_BASE_URL=http://localhost:8000
# Azure build: set the actual HTTPS API origin before npm run build.
# VITE_API_BASE_URL=https://your-api.azurecontainerapps.io
# VITE_API_URL remains a supported compatibility alias.
